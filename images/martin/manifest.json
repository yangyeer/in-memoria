    { "file": "11.webp", "caption": "Готов к труду, обороне и салюту" },
    { "file": "12.webp", "caption": "Первый раз в первый класс. Зачем?" },
    { "file": "13.webp", "caption": "Урожай собран. Стол накрыт. Я готов" },
