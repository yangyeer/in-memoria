    { "file": "06.webp", "caption": "Лесной дух и его шаманка" },
    { "file": "07.webp", "caption": "Ветер в ушах — счастье в глазах" },
    { "file": "08.webp", "caption": "А что у вас там? А мне дадут?" },
    { "file": "09.webp", "caption": "Дележ по-дружески: косточка на двоих" },
